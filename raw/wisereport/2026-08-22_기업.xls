			.hd { font: bold 9pt '맑은 고딕'; color: rgb(53,91,157); height: 30px; background-color: rgb(247,247,247); text-align: center;border-top:1px rgb(47,71,107) solid}
			.strdeg{mso-width-source:userset;width:80px;height: 24px;text-align: left}
			.pre_recomm{mso-width-source:userset;width:80px;height: 24px;text-align: left}
			.recomm{width:80px;height: 24px;text-align: left}
			.brk{mso-width-source:userset;width:110px;height: 24px;text-align: left}
			.cmp,.ind{mso-width-source:userset;width:90px;height: 24px;text-align: left}
			.strprc{mso-width-source:userset;width:60px;height: 24px;text-align: right}
			.pre_targer_prc{mso-width-source:userset;width:60px;height: 24px;text-align: right}
			.close_prc{mso-width-source:userset;width:80px;height: 24px;text-align: right}
			.comment{width:500px;height: 49px;}
			.comment2{width:450px;height: 49px;}
