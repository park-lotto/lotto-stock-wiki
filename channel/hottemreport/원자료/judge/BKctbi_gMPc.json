  ],
  "speed": "보통"
 },
 "hook": {
  "text": "지구에서 쓰는 일론 머스크 헬멧?",
  "t_end": 0.0,
  "why": "유명인(일론 머스크)의 이름과 예상치 못한 상황(지구에서 쓰는 헬멧)을 결합하여 시청자의 호기심을 자극합니다."
 },
 "beats": [
  {
   "t0": 0.0,
   "t1": 0.1,
   "fn": "훅",
   "text": "일론 머스크 헬멧?"
  },
  {
   "t0": 0.1,
   "t1": 0.3,
   "fn": "정체공개",
   "text": "지구에서 쓰는 일론 머스크 헬멧의 정체"
  },
  {
   "t0": 0.3,
   "t1": 0.4,
   "fn": "상황",
   "text": "스페이스X 우주복 닮아"
  },
  {
   "t0": 0.4,
   "t1": 0.5,
   "fn": "상황",
   "text": "머스크 헬멧으로 화제였지만,"
  },
  {
   "t0": 0.5,
   "t1": 0.7,
   "fn": "반전",
   "text": "사실 마이클 홀이 코로나 때 만든 풀페이스 마스크임."
  },
  {
   "t0": 0.7,
   "t1": 0.8,
   "fn": "상황",
   "text": "당시엔 조롱을 받았는데"
  },
  {
   "t0": 0.8,
   "t1": 1.1,
   "fn": "반전",
   "text": "오히려 목공, 도색, 용접 현장에서 대박난 거임."
  },
  {
   "t0": 1.1,
   "t1": 1.2,
   "fn": "의문",
   "text": "이유가 재밌음"
  },
  {
   "t0": 1.2,
   "t1": 1.4,
   "fn": "원리",
   "text": "기존 마스크는 밀착이 필수인데"
  },
  {
   "t0": 1.4,
   "t1": 1.6,
   "fn": "원리",
   "text": "형님들이 다 수염이 있었던 거"
  },
  {
   "t0": 1.6,
   "t1": 1.8,
   "fn": "원리",
   "text": "근데 이건 수염도 상관없고"
  },
  {
   "t0": 1.8,
   "t1": 2.1,
   "fn": "원리",
   "text": "고글, 귀마개, 방진 마스크까지 다 따로 쓰던 거, 이거 하나로 끝!"
  },
  {
   "t0": 2.1,
   "t1": 2.2,
   "fn": "의문",
   "text": "저 죽는 거 아니야 싶지?"
  },
  {
   "t0": 2.2,
   "t1": 2.4,
   "fn": "원리",
   "text": "전동 팬이 P100급 필터로 거른 공기를"
  },
  {
   "t0": 2.4,
   "t1": 2.6,
   "fn": "원리",
   "text": "분당 200L씩 밀어넣어"
  },
  {
   "t0": 2.6,
   "t1": 2.7,
   "fn": "원리",
   "text": "입김도 없이 오히려 상쾌!"
  },
  {
   "t0": 2.7,
   "t1": 2.8,
   "fn": "덤",
   "text": "충전 한 번에 8시간 사용!"
  },
  {
   "t0": 2.8,
   "t1": 3.0,
   "fn": "덤",
   "text": "심지어 미산업안전보건연구원 승인으로 안전성도 인정!"
  },
  {
   "t0": 3.0,
   "t1": 3.3,
   "fn": "결말",
   "text": "아 근데 코로나보다 더 빡센 팬데믹 오면 우리도 이거 쓰는 거 아니야?"
  }
 ],
 "script": "지구에서 쓰는 일론 머스크 헬멧?\n지구에서 쓰는 일론 머스크 헬멧의 정체\n스페이스X 우주복 닮아\n머스크 헬멧으로 화제였지만,\n사실 마이클 홀이 코로나 때 만든 풀페이스 마스크임.\n당시엔 조롱을 받았는데\n오히려 목공, 도색, 용접 현장에서 대박난 거임.\n이유가 재밌음\n기존 마스크는 밀착이 필수인데\n형님들이 다 수염이 있었던 거\n근데 이건 수염도 상관없고\n고글, 귀마개, 방진 마스크까지 다 따로 쓰던 거, 이거 하나로 끝!\n저 죽는 거 아니야 싶지?\n전동 팬이 P100급 필터로 거른 공기를\n분당 200L씩 밀어넣어\n입김도 없이 오히려 상쾌!\n충전 한 번에 8시간 사용!\n심지어 미산업안전보건연구원 승인으로 안전성도 인정!\n아 근데 코로나보다 더 빡센 팬데믹 오면 우리도 이거 쓰는 거 아니야?",
