[
  {
    "from": 0,
    "to": 40,
    "text": "반갑습니다.",
    "accent": "반갑습니다"
  },
  {
    "from": 62,
    "to": 84,
    "text": "스탑브레인입니다.",
    "accent": "스탑브레인입니다"
  },
  {
    "from": 106,
    "to": 106,
    "text": "자,",
    "accent": ""
  },
  {
    "from": 122,
    "to": 220,
    "text": "아침에 우리 눈 뜨자마자 주식 하시는 분들 솔직히",
    "accent": "주식"
  },
  {
    "from": 220,
    "to": 257,
    "text": "다 똑같죠?",
    "accent": ""
  },
  {
    "from": 268,
    "to": 327,
    "text": "폰부터 잡고 하루를 시작합니다.",
    "accent": "하루"
  },
  {
    "from": 349,
    "to": 386,
    "text": "어제 종배하신 분들,",
    "accent": "종배하신"
  },
  {
    "from": 403,
    "to": 498,
    "text": "야간 선물 어떻게 됐는지 긴장하면서 보실 거고요.",
    "accent": "선물"
  },
  {
    "from": 511,
    "to": 587,
    "text": "미국장 어떻게 됐는지 쓱 봐야 되고,",
    "accent": ""
  },
  {
    "from": 595,
    "to": 675,
    "text": "내가 가진 종목들, 뉴스 뜬 거 있나 막 뒤져봐야",
    "accent": "뉴스"
  },
  {
    "from": 675,
    "to": 700,
    "text": "되죠?",
    "accent": ""
  },
  {
    "from": 726,
    "to": 816,
    "text": "텔레그램이랑 유튜브 시황 그런 거 보다 보면",
    "accent": "텔레그램"
  },
  {
    "from": 816,
    "to": 866,
    "text": "정신없이 8시가 금세 됩니다.",
    "accent": ""
  },
  {
    "from": 866,
    "to": 992,
    "text": "정작 제일 중요한 장 열릴 때는 눈도 침침하고",
    "accent": "침침하고"
  },
  {
    "from": 992,
    "to": 1050,
    "text": "머리도 잘 안 돌아가잖아요.",
    "accent": "돌아가잖아요"
  },
  {
    "from": 1065,
    "to": 1170,
    "text": "아침부터 준비가 안 된 상황이라서 다 그런 겁니다.",
    "accent": "아침"
  },
  {
    "from": 1184,
    "to": 1296,
    "text": "그래서 결국 장 초반부터 허둥지둥 하다가 계획도",
    "accent": "허둥지둥"
  },
  {
    "from": 1296,
    "to": 1385,
    "text": "없던 뇌동매매로 하루를 꼬이면서 시작을 하게 되는",
    "accent": "뇌동매매"
  },
  {
    "from": 1385,
    "to": 1398,
    "text": "거죠.",
    "accent": ""
  },
  {
    "from": 1423,
    "to": 1526,
    "text": "제 말이 맞나요? 매일 아침 반복되는 이 지독한",
    "accent": "아침"
  },
  {
    "from": 1526,
    "to": 1576,
    "text": "정보수집 노가다들,",
    "accent": "정보수집"
  },
  {
    "from": 1588,
    "to": 1710,
    "text": "이제 클로드한테 통째로 외주 맡기자고요. 진짜 쉽게",
    "accent": "클로드"
  },
  {
    "from": 1710,
    "to": 1752,
    "text": "끝납니다. 한번 보세요.",
    "accent": "끝납니다"
  }
]