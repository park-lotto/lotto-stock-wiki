{
 "steps": [
  {
   "text": "코스트코가 가격표에 숨겨 둔 암호",
   "chars": 14,
   "new_cut": true,
   "sent": 0,
   "line": 0,
   "t0": 0.0,
   "t1": 1.748
  },
  {
   "text": "장 보러 가면 다들 그냥",
   "chars": 9,
   "new_cut": true,
   "sent": 1,
   "line": 1,
   "t0": 1.748,
   "t1": 2.975
  },
  {
   "text": "장 보러 가면 다들 그냥\n지나치는, 코스트코 가격표",
   "chars": 12,
   "new_cut": false,
   "sent": 1,
   "line": 1,
   "t0": 2.975,
   "t1": 4.77
  },
  {
   "text": "하지만 이 숫자, 끝자리만",
   "chars": 11,
   "new_cut": true,
   "sent": 2,
   "line": 2,
   "t0": 4.77,
   "t1": 6.116
  },
  {
   "text": "하지만 이 숫자, 끝자리만\n봐도, 할인인지 아닌지 갈린다는데",
   "chars": 15,
   "new_cut": false,
   "sent": 2,
   "line": 2,
   "t0": 6.116,
   "t1": 8.133
  },
  {
   "text": "사실 끝자리 90원은",
   "chars": 9,
   "new_cut": true,
   "sent": 3,
   "line": 3,
   "t0": 8.133,
   "t1": 9.145
  },
  {
   "text": "사실 끝자리 90원은\n그냥 정가고, 70원이면",
   "chars": 11,
   "new_cut": false,
   "sent": 3,
   "line": 3,
   "t0": 9.145,
   "t1": 10.691
  },
  {
   "text": "할인 중이라는 거",
   "chars": 7,
   "new_cut": true,
   "sent": 3,
   "line": 3,
   "t0": 10.691,
   "t1": 11.696
  },
  {
   "text": "문제는 그 할인이",
   "chars": 7,
   "new_cut": true,
   "sent": 4,
   "line": 4,
   "t0": 11.696,
   "t1": 12.711
  },
  {
   "text": "문제는 그 할인이\n언제 끝날지 모른다고",
   "chars": 9,
   "new_cut": false,
   "sent": 4,
   "line": 4,
   "t0": 12.711,
   "t1": 14.015
  },
  {
   "text": "그래서 미국 틱톡에선 상품번호",
   "chars": 13,
   "new_cut": true,
   "sent": 5,
   "line": 5,
   "t0": 14.015,
   "t1": 15.345
  },
  {
   "text": "그래서 미국 틱톡에선 상품번호\n옆 별표를, 죽음의 별이라",
   "chars": 11,
   "new_cut": false,
   "sent": 5,
   "line": 5,
   "t0": 15.345,
   "t1": 16.61
  },
  {
   "text": "부르는데, 재입고가 더는 없다는 뜻",
   "chars": 15,
   "new_cut": true,
   "sent": 5,
   "line": 5,
   "t0": 16.61,
   "t1": 18.145
  },
  {
   "text": "심지어 00원은 매장마다",
   "chars": 11,
   "new_cut": true,
   "sent": 6,
   "line": 6,
   "t0": 18.145,
   "t1": 19.1
  },
  {
   "text": "심지어 00원은 매장마다\n가격이 다르고, 플러스는",
   "chars": 11,
   "new_cut": false,
   "sent": 6,
   "line": 6,
   "t0": 19.1,
   "t1": 20.904
  },
  {
   "text": "용량 변경이나 단종 신호라는 얘기",
   "chars": 14,
   "new_cut": true,
   "sent": 6,
   "line": 6,
   "t0": 20.904,
   "t1": 22.673
  },
  {
   "text": "근데 댓글에선 70원도 무조건",
   "chars": 13,
   "new_cut": true,
   "sent": 7,
   "line": 7,
   "t0": 22.673,
   "t1": 24.094
  },
  {
   "text": "근데 댓글에선 70원도 무조건\n싼 건 아니라며, 온라인이랑",
   "chars": 12,
   "new_cut": false,
   "sent": 7,
   "line": 7,
   "t0": 24.094,
   "t1": 25.405
  },
  {
   "text": "꼭 비교하라고 함",
   "chars": 7,
   "new_cut": true,
   "sent": 7,
   "line": 7,
   "t0": 25.405,
   "t1": 26.17
  },
  {
   "text": "결국 코스트코 가격표는",
   "chars": 10,
   "new_cut": true,
   "sent": 8,
   "line": 8,
   "t0": 26.17,
   "t1": 27.415
  },
  {
   "text": "결국 코스트코 가격표는\n가격보다 끝자리부터 읽는",
   "chars": 11,
   "new_cut": false,
   "sent": 8,
   "line": 8,
   "t0": 27.415,
   "t1": 28.734
  },
  {
   "text": "거였다고ㅋㅋ",
   "chars": 6,
   "new_cut": true,
   "sent": 8,
   "line": 8,
   "t0": 28.734,
   "t1": 29.418
  }
 ],
