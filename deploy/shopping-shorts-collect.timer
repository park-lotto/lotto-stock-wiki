[Unit]
Description=매일 유튜브 자동수집 타이머(08:10 KST 우선, 렌더 중이면 재시도)

[Timer]
# 서버 시간대 기준. KST(Asia/Seoul). 08:10이 본 회차 — 장 시작 전 신선한 랭킹.
# ★나머지는 재시도용(2026-08-31): 스크립트가 렌더/믹스 중이면 양보하고 그냥 끝나는데,
#   예전엔 하루 1회뿐이라 그 순간 렌더가 돌면 **그날 수집이 통째로 날아갔다**
#   (실사고 08-31: 하루 0건). 성공한 날은 스크립트가 표식(daily_collect_done::youtube)을
#   보고 남은 회차를 건너뛰므로, 회차를 늘려도 중복 수집은 없다.
OnCalendar=*-*-* 08:10:00
OnCalendar=*-*-* 11:10:00
OnCalendar=*-*-* 14:10:00
OnCalendar=*-*-* 17:10:00
OnCalendar=*-*-* 20:10:00
OnCalendar=*-*-* 22:40:00
Persistent=true
# 부팅/중단으로 놓친 실행은 다음 부팅 때 1회 보충(Persistent).

[Install]
WantedBy=timers.target
