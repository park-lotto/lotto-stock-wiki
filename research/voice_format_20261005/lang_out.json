    "s": 21.1,
    "e": 23.1,
    "lang": "ko",
    "p": 0.96,
    "ko_text": "일본 문구의 디테일에 또 한번 감탄하고 말았다고"
   }
  ]
 },
 "t65c0N0Y2sA": {
