[Unit]
Description=Shopping Shorts Reference Ranking (FastAPI :8849)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/lotto-stock-wiki
EnvironmentFile=/etc/shopping-shorts.env
ExecStart=/usr/bin/python3 -m uvicorn shopping_shorts.app:app --host 127.0.0.1 --port 8849
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
