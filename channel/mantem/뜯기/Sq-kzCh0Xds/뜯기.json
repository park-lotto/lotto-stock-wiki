   "segments": [
    {
     "start": 0.0,
     "end": 4.1,
     "text": "모두가 있어야 되는 거. 고등학교 때부터 이 양념을 썼어.",
     "speaker": "S1",
     "lang": "ko",
     "kind": "dialog"
    },
    {
     "start": 4.1,
     "end": 5.4,
     "text": "너무 맛있어요.",
     "speaker": "S1",
     "lang": "ko",
     "kind": "dialog"
    },
    {
     "start": 5.4,
     "end": 7.7,
     "text": "강주은이 극찬한 30년 요리 비법 양념이라는데",
     "speaker": "S2",
     "lang": "ko",
     "kind": "narration"
    },
    {
     "start": 7.7,
