{
 "steps": [
  {
   "text": "요즘 편의점에서 리센느",
   "chars": 10,
   "new_cut": true,
   "sent": 0,
   "t0": 0.0,
   "t1": 1.11
  },
  {
   "text": "요즘 편의점에서 리센느\n빵 구경해 본 사람 있음?",
   "chars": 10,
   "new_cut": false,
   "sent": 0,
   "t0": 1.11,
   "t1": 2.437
  },
  {
   "text": "CU가 리센느 멤버들이",
   "chars": 10,
   "new_cut": true,
   "sent": 1,
   "t0": 2.437,
   "t1": 3.606
  },
  {
   "text": "CU가 리센느 멤버들이\n각자 좋아하는 빵으로",
   "chars": 9,
   "new_cut": false,
   "sent": 1,
   "t0": 3.606,
   "t1": 4.605
  },
  {
   "text": "다섯 가지를 내놨는데",
   "chars": 9,
   "new_cut": true,
   "sent": 1,
   "t0": 4.605,
   "t1": 5.604
  },
  {
   "text": "첫날 풀린 원이의",
   "chars": 7,
   "new_cut": true,
   "sent": 2,
   "t0": 5.604,
   "t1": 6.381
  },
  {
   "text": "첫날 풀린 원이의\n옥수수크림빵이 하루도",
   "chars": 10,
   "new_cut": false,
   "sent": 2,
   "t0": 6.381,
   "t1": 7.491
  },
  {
   "text": "안 돼서 99% 팔리고",
   "chars": 9,
   "new_cut": true,
   "sent": 2,
   "t0": 7.491,
   "t1": 8.697
  },
  {
   "text": "안 돼서 99% 팔리고\n나흘 만에 10만 개가 나갔다고 함.",
   "chars": 15,
   "new_cut": false,
   "sent": 2,
   "t0": 8.697,
   "t1": 10.362
  },
  {
   "text": "알고 보니 빵마다 멤버",
   "chars": 9,
   "new_cut": true,
   "sent": 3,
   "t0": 10.362,
   "t1": 11.361
  },
  {
   "text": "알고 보니 빵마다 멤버\n투명 포카가 한 장씩",
   "chars": 8,
   "new_cut": false,
   "sent": 3,
   "t0": 11.361,
   "t1": 12.25
  },
  {
   "text": "랜덤으로 들어 있어서",
   "chars": 9,
   "new_cut": true,
   "sent": 3,
   "t0": 12.25,
   "t1": 13.249
  },
  {
   "text": "랜덤으로 들어 있어서\n그 포카가 중고로",
   "chars": 7,
   "new_cut": false,
   "sent": 3,
   "t0": 13.249,
   "t1": 14.168
  },
  {
   "text": "빵값보다 몇 배 비싸게",
   "chars": 9,
   "new_cut": true,
   "sent": 3,
   "t0": 14.168,
   "t1": 15.167
  },
  {
   "text": "빵값보다 몇 배 비싸게\n거래될 정도였다는데",
   "chars": 9,
   "new_cut": false,
   "sent": 3,
   "t0": 15.167,
   "t1": 16.166
  },
  {
   "text": "근데 60만 개 넘게 팔린",
   "chars": 10,
   "new_cut": true,
   "sent": 4,
   "t0": 16.166,
   "t1": 17.569
  },
  {
   "text": "근데 60만 개 넘게 팔린\n이 빵, 제일 많이 사 간",
   "chars": 9,
   "new_cut": false,
   "sent": 4,
   "t0": 17.569,
   "t1": 18.518
  },
  {
   "text": "쪽은 10대 팬이 아니라",
   "chars": 10,
   "new_cut": true,
   "sent": 4,
   "t0": 18.518,
   "t1": 19.881
  },
  {
   "text": "쪽은 10대 팬이 아니라\n30대 남자들이었다는 것.",
   "chars": 12,
   "new_cut": false,
   "sent": 4,
   "t0": 19.881,
   "t1": 21.214
  },
  {
   "text": "댓글에선 우리는 빵이",
   "chars": 9,
   "new_cut": true,
   "sent": 5,
   "t0": 21.214,
   "t1": 22.213
  },
  {
   "text": "댓글에선 우리는 빵이\n아니라 포카를 사는 거고",
   "chars": 10,
   "new_cut": false,
   "sent": 5,
   "t0": 22.213,
   "t1": 23.323
  },
  {
   "text": "빵은 덤이라는 쪽이랑",
   "chars": 9,
   "new_cut": true,
   "sent": 5,
   "t0": 23.323,
   "t1": 24.322
  },
  {
   "text": "빵은 덤이라는 쪽이랑\n포카 다 모으느라 빵만",
   "chars": 9,
   "new_cut": false,
   "sent": 5,
   "t0": 24.322,
   "t1": 25.321
  },
  {
   "text": "60개 넘게 먹었다는",
   "chars": 9,
   "new_cut": true,
   "sent": 5,
   "t0": 25.321,
   "t1": 26.32
  },
  {
   "text": "60개 넘게 먹었다는\n후기까지 나왔다고 함.",
   "chars": 10,
   "new_cut": false,
   "sent": 5,
   "t0": 26.32,
   "t1": 27.43
  }
 ],
