  "transcript": {
   "model": "gemini-3.5-flash",
   "warnings": [
    "길이 초과 14.6~15.8"
   ],
   "segments": [
    {
     "start": 0.0,
     "end": 1.83,
     "text": "되게 가볍죠, 맞아. 앉아 보세요.",
     "speaker": "S1",
     "lang": "ko",
     "kind": "dialog"
    },
    {
     "start": 1.83,
     "end": 4.22,
     "text": "한 손으로 툭툭 들어도 될 정도로 가벼운 쇼파라는데",
     "speaker": "S2",
     "lang": "ko",
     "kind": "dialog"
    },
    {
     "start": 4.22,
     "end": 5.51,
     "text": "엄청 유명한 브랜드예요.",
     "speaker": "S1",
     "lang": "ko",
     "kind": "dialog"
    },
    {
     "start": 5.51,
     "end": 6.64,
     "text": "어뜸에 유명한가요?",
     "speaker": "S2",
     "lang": "ko",
     "kind": "dialog"
    },
    {
     "start": 6.64,
     "end": 7.91,
     "text": "앉아보면, 파묻혀요, 사실.",
     "speaker": "S1",
     "lang": "ko",
     "kind": "dialog"
    },
    {
     "start": 7.91,
     "end": 8.85,
     "text": "앉는 느낌이",
     "speaker": "S1",
     "lang": "ko",
     "kind": "dialog"
    },
    {
     "start": 8.85,
     "end": 10.04,
     "text": "몸을 딱 감싸준다네요?",
     "speaker": "S2",
     "lang": "ko",
     "kind": "dialog"
    },
    {
     "start": 10.04,
     "end": 10.97,
     "text": "포근한 거지.",
     "speaker": "S1",
     "lang": "ko",
     "kind": "dialog"
    },
    {
     "start": 10.97,
     "end": 11.64,
     "text": "앉아보셔야 돼.",
     "speaker": "S1",
     "lang": "ko",
     "kind": "dialog"
    },
    {
     "start": 11.64,
     "end": 12.87,
     "text": "가격은 좀 비싸다는데요?",
     "speaker": "S2",
     "lang": "ko",
     "kind": "dialog"
    },
    {
     "start": 12.87,
     "end": 13.8,
     "text": "가격이 사악해요, 어~",
     "speaker": "S1",
     "lang": "ko",
     "kind": "dialog"
    },
    {
     "start": 13.8,
     "end": 14.6,
     "text": "장점이 많은 만큼!",
     "speaker": "S1",
     "lang": "ko",
     "kind": "dialog"
    },
    {
     "start": 14.6,
     "end": 15.2,
     "text": "금액 보고 한번 들어보고 올게요.",
     "speaker": "S2",
     "lang": "ko",
     "kind": "dialog"
    }
   ],
   "n": 13,
   "langs": [
    "ko"
   ],
   "ambient": "",
