   1.71,
   1.77
  ],
  "first_dialog_at": 14.96,
  "lines": [
   {
    "role": "나레",
    "start": 0.05,
    "end": 14.84,
    "chars": 123,
    "text": "가구공장 사장이 개발팀한테 당황했던 이유 최근 한 하이엔드 브랜드 제조사가 극강의 오피스 체어를 만드는데 원가 따지지 말고 만들어 보라고 했더니 개발팀이 진짜 미친 짓을 해버린 건데 엉덩이 밑에 4천알피엠 쿨링팬을 박아버리더니 앉으면 알아서 바람이 나오는 미친 센서를 넣어버렸다는 거 사장님"
   },
   {
    "role": "사장",
    "start": 14.96,
    "end": 16.67,
    "chars": 15,
    "text": "아니 팬까지 넣으면 가격이 어떻게 해"
   },
   {
    "role": "나레",
    "start": 16.7,
    "end": 17.18,
    "chars": 4,
    "text": "라고 하자"
   },
   {
    "role": "개발팀",
    "start": 17.18,
    "end": 18.95,
    "chars": 14,
    "text": "허리 뒤에 전동모터도 넣었는데요"
   },
   {
    "role": "나레",
    "start": 18.95,
    "end": 27.35,
    "chars": 76,
    "text": "라며 100만원대 괴물 의자를 완성해버림 근데 진짜 소름끼치는 반전은 자세 바꿀때마다 등받이랑 헤드레스트가 모터로 실시간 추종해주니까 하루종일 앉아있어도 허리가 호강한다고"
   }
  ]
 },
 "7DYbxVNz5q8": {
  "roles": {
   "나레": {
