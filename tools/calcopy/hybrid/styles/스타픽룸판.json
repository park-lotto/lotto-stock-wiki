    "of": "tts",
    "min": 6,
    "max": 8
   },
   {
    "kind": "tts_chars",
    "min": 8,
    "max": 35
   },
   {
    "kind": "ending",
    "which": "first_tts",
    "pattern": "있다는데\\s*\\.*\\?*$",
    "why": "나레 다리 = 전언 '~있다는데..?'"
   },
   {
    "kind": "has_line",
    "of": "tts",
    "pattern": "(저도|제가).*(봤는데|봤어요)",
    "min": 1,
    "why": "1인칭 체험 이음"
   },
   {
    "kind": "ending",
    "which": "rest_tts",
    "pattern": "(더라고요|봤는데요|대요|래요|같아요|거예요|어요|에요|해요|네요)\\s*[.,!]*$",
    "min_share": 0.7,
