{
 "steps": [
  {
   "text": "요즘 구미공장 신라면만",
   "chars": 10,
   "new_cut": true,
   "sent": 0,
   "t0": 0.0,
   "t1": 1.112
  },
  {
   "text": "요즘 구미공장 신라면만\n골라 산다는 얘기 아는 사람?",
   "chars": 12,
   "new_cut": false,
   "sent": 0,
   "t0": 1.112,
   "t1": 2.446
  },
  {
   "text": "한 유튜버가 같은",
   "chars": 7,
   "new_cut": true,
   "sent": 1,
   "t0": 2.446,
   "t1": 3.504
  },
  {
   "text": "한 유튜버가 같은\n신라면을 구미공장 거랑",
   "chars": 10,
   "new_cut": false,
   "sent": 1,
   "t0": 3.504,
   "t1": 4.615
  },
  {
   "text": "안성공장 거로 나눠서",
   "chars": 9,
   "new_cut": true,
   "sent": 1,
   "t0": 4.615,
   "t1": 5.616
  },
  {
   "text": "안성공장 거로 나눠서\n똑같은 물 양으로 끓여 봤는데",
   "chars": 12,
   "new_cut": false,
   "sent": 1,
   "t0": 5.616,
   "t1": 6.95
  },
  {
   "text": "구미 쪽이 국물 색도",
   "chars": 8,
   "new_cut": true,
   "sent": 2,
   "t0": 6.95,
   "t1": 7.839
  },
  {
   "text": "구미 쪽이 국물 색도\n더 진하고 기름기도 많아서",
   "chars": 11,
   "new_cut": false,
   "sent": 2,
   "t0": 7.839,
   "t1": 9.062
  },
  {
   "text": "훨씬 맛있다는 평이 나왔다고 함.",
   "chars": 14,
   "new_cut": true,
   "sent": 2,
   "t0": 9.062,
   "t1": 10.791
  },
  {
   "text": "이게 퍼지자 봉지 뒷면에",
   "chars": 10,
   "new_cut": true,
   "sent": 3,
   "t0": 10.791,
   "t1": 12.094
  },
  {
   "text": "이게 퍼지자 봉지 뒷면에\n적힌 공장을 보고 구미 걸",
   "chars": 10,
   "new_cut": false,
   "sent": 3,
   "t0": 12.094,
   "t1": 13.365
  },
  {
   "text": "사 갔더니 마트 사장님이",
   "chars": 10,
   "new_cut": true,
   "sent": 3,
   "t0": 13.365,
   "t1": 14.656
  },
  {
   "text": "사 갔더니 마트 사장님이\n요즘 왜 구미 것만 찾냐고",
   "chars": 10,
   "new_cut": false,
   "sent": 3,
   "t0": 14.656,
   "t1": 15.768
  },
  {
   "text": "물어봤다는 글까지 올라왔는데",
   "chars": 13,
   "new_cut": true,
   "sent": 3,
   "t0": 15.768,
   "t1": 17.213
  },
  {
   "text": "근데 알고 보니",
   "chars": 6,
   "new_cut": true,
   "sent": 4,
   "t0": 17.213,
   "t1": 17.88
  },
  {
   "text": "근데 알고 보니\n구미공장은 원래 국내",
   "chars": 9,
   "new_cut": false,
   "sent": 4,
   "t0": 17.88,
   "t1": 18.88
  },
  {
   "text": "신라면 넷 중 셋을 만드는",
   "chars": 10,
   "new_cut": true,
   "sent": 4,
   "t0": 18.88,
   "t1": 19.992
  },
  {
   "text": "신라면 넷 중 셋을 만드는\n곳이라 구미 에디션이",
   "chars": 9,
   "new_cut": false,
   "sent": 4,
   "t0": 19.992,
   "t1": 20.992
  },
  {
   "text": "사실상 신라면",
   "chars": 6,
   "new_cut": true,
   "sent": 4,
   "t0": 20.992,
   "t1": 21.659
  },
  {
   "text": "사실상 신라면\n본진이었다는 것.",
   "chars": 8,
   "new_cut": false,
   "sent": 4,
   "t0": 21.659,
   "t1": 22.921
  },
  {
   "text": "댓글에선 공장을 알고",
   "chars": 9,
   "new_cut": true,
   "sent": 5,
   "t0": 22.921,
   "t1": 23.676
  },
  {
   "text": "댓글에선 공장을 알고\n먹었으니 블라인드로",
   "chars": 9,
   "new_cut": false,
   "sent": 5,
   "t0": 23.676,
   "t1": 24.676
  },
  {
   "text": "다시 하라는 쪽이랑",
   "chars": 8,
   "new_cut": true,
   "sent": 5,
   "t0": 24.676,
   "t1": 25.565
  },
  {
   "text": "다시 하라는 쪽이랑\n서울 와서 신라면 맛이",
   "chars": 9,
   "new_cut": false,
   "sent": 5,
   "t0": 25.565,
   "t1": 26.566
  },
  {
   "text": "변한 게 공장 탓이었냐는",
   "chars": 10,
   "new_cut": true,
   "sent": 5,
   "t0": 26.566,
   "t1": 27.82
  },
  {
   "text": "변한 게 공장 탓이었냐는\n쪽으로 갈렸다고 함.",
   "chars": 9,
   "new_cut": false,
   "sent": 5,
   "t0": 27.82,
   "t1": 28.821
  }
 ],
