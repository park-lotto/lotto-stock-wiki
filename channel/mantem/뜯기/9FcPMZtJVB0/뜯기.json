   "segments": [
    {
     "start": 0.0,
     "end": 1.83,
     "text": "요즘에는 저는 이것만 들어.",
     "speaker": "S2",
     "lang": "ko",
     "kind": "source"
    },
    {
     "start": 1.83,
     "end": 3.56,
     "text": "김혜수가 엄청 아끼는 명품 가방이라는데",
     "speaker": "S1",
     "lang": "ko",
     "kind": "narration"
    },
    {
     "start": 3.56,
     "end": 25.41,
     "text": "최근에 가장 애정하는 가방이고요. 원래 저는 좀 이렇게 굉장히 큰 빅백이나 아니면 아주 작은 스몰백을 선호하는 편이었는데 가장 적당한 사이즈를 좀 찾은 것 같은 느낌. 디자인적으로도 굉장히 마음에 들고요. 단순하면서도 엣지들이 좀 있어요. 포멀한 스타일이건 캐주얼한 스타일이건 어느 옷에나 좀 아주 잘 맞아요. 정말 애정하는 가방입니다.",
     "speaker": "S2",
     "lang": "ko",
     "kind": "source"
    },
    {
     "start": 25.41,
     "end": 27.27,
     "text": "요즘 연예인들 사이에서 난리났네요.",
     "speaker": "S1",
     "lang": "ko",
     "kind": "narration"
    }
   ],
   "n": 4,
   "langs": [
    "ko"
   ],
   "ambient": "",
   "speech_sec_all": 27.27,
