{"segments": [{"start": 0.0, "end": 4.2, "text": "I'm going to test to see if this works for mosquitoes, since the mosquitoes were everywhere.", "kind": "speech"}, {"start": 4.2, "end": 5.1, "text": "Not standing right there.", "kind": "speech"}, {"start": 5.1, "end": 6.4, "text": "Okay, I'm going to go.", "kind": "speech"}, {"start": 6.4, "end": 8.5, "text": "So I was getting destroyed right here.", "kind": "speech"}, {"start": 14.2, "end": 17.4, "text": "I see a bunch of mosquitoes, but they're not coming near me. Oh, there's one.", "kind": "speech"}, {"start": 17.4, "end": 18.5, "text": "Is that it?", "kind": "speech"}, {"start": 19.3, "end": 23.0, "text": "Like they were everywhere over there and I could see them, but they weren't coming at me,", "kind": "speech"}, {"start": 23.0, "end": 25.6, "text": "except one did come at me, but it didn't bite me.", "kind": "speech"}, {"start": 25.6, "end": 27.1, "text": "There's one right there.", "kind": "speech"}, {"start": 27.1, "end": 28.0, "text": "It's on you.", "kind": "speech"}, {"start": 28.0, "end": 29.1, "text": "And then it just flew away.", "kind": "speech"}, {"start": 29.1, "end": 31.0, "text": "Yeah, they fly away. Like when you're near though?", "kind": "speech"}, {"start": 31.0, "end": 32.4, "text": "Yeah, like they're just less.", "kind": "speech"}, {"start": 32.4, "end": 33.8, "text": "They're all over you.", "kind": "speech"}, {"start": 34.2, "end": 35.2, "text": "It's working.", "kind": "speech"}, {"start": 35.2, "end": 36.6, "text": "I'd say so.", "kind": "speech"}, {"start": 36.6, "end": 42.1, "text": "I'm not like 100% confirmed, but like it seems like it. Okay.", "kind": "speech"}, {"start": 42.2, "end": 44.3, "text": "We got to take it into the bush next time.", "kind": "speech"}, {"start": 44.3, "end": 45.0, "text": "Yeah.", "kind": "speech"}], "music": true, "_model": "gemini-3.5-flash"}