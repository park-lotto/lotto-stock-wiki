{
 "molds": {
  "H1": "지인 집·가게 목격 — 친구 집/카페 놀러 갔다가 ~보고 깜짝 놀랐어요",
  "H2": "가족이 해 둠·사 옴·선물 — 와이프가 ~에 이런 걸 해놨는데/사왔는데, 엄마한테 선물했는데",
  "H3": "말 걸기 감탄 — 와 서랍 왜 이렇게 깔끔해? / 이거 만든 사람 천재 아니에요?(상대에게 말 걸듯 감탄)",
  "H4": "소비 고백 — ~사려고 했다가 혼났어요 / 이거 보고 ~절대 안 사요 / ~했는데 이거 보고 후회 / 이걸 지금 알았어요 / ~인 줄 알았어요",
  "H5": "갈등 사건 — 집주인이랑 싸울 뻔 / 집주인이 놔두고 가래요 / 친구한테 원시인 취급 / 담임선생님 전화",
  "H6": "경고·명령 — 비싸게 ~하지 말고 이거 해보세요 / ~절대 쓰지 마세요 / 다이소 가면 무조건 사오세요 / 이거 하나면 ~필요 없어요",
  "H7": "내 일상 변화·주변 반응 — ~샀는데 보는 사람마다 어디서 샀냐고 / 이거 하나 바꿨는데 ~달라졌어요 / 요즘 스트레스 받을 때 이거만한 게",
  "I1": "만든 사람 — (꾸밈) 개발자·회사·덕후가 만들어서 ~난리 난 / ~만들어버린 미친 회사가 있어요",
  "I2": "권위·장소·유행 — 고급 호텔 가면 많이 보이는 / 정리업체 사장님들이 쓴다는 / 이케아 직원 강추 / 해외에서 인기 / 몇천 년 전부터",
  "I3": "브랜드 위기 — 이제 DJI 망할 것 같은데요? / 다이슨 큰일났습니다",
  "I4": "이유·호기심 질문 — 왜 ~일까요? / ~를 보고 혀를 내두른 이유?",
  "I5": "집단 감탄 — 와 이거 덕후님들 눈 좀 돌아가겠는데요 / 이거 ~타는 사람이 보면",
  "I6": "공감 도발 — 와 여러분 ~좁아 죽겠나요? 그러면 이거 쓰세요 / 아직도 ~하고 계신가요?",
  "X1": "되묻기 — 아니 이게 ~가 아니라 ~라고요? / ~할 수 있다고요?",
  "X2": "지식 질문 — ~를 아시나요? / 들어보셨나요?",
  "H8": "고민 해결담 — ~하려고 알아보다가 / ~고민하다가 이걸로 해결했어요 / 전세라 ~망설였는데 / ~꺼냈는데 더러워진 거예요(내 문제 한 장면으로 시작)",
  "H9": "화자 경력 권위 — 제가 대기업 10년 다니면서 / 제작 가구에 천만 원 넘게 쓰면서 / 제가 지금까지 많이 봤는데",
  "H10": "발견·반함 — ~찾았어요 / 한눈에 반했어요 / 발견했는데 이거다 싶었어요 / 쇼룸·박람회 갔다가",
  "I7": "정체 반전 선언(단정) — 와 이거 피규어가 아니라 키캡입니다 / 여러분 이게 난로예요 (질문이 아니라 단정)",
  "I8": "위험 사실 경고 — 낙상사고의 70%가 현관에서 / 이걸 모르면 대형 사고 / 이게 초록색으로 변하면 큰일",
  "Z": "위 어디에도 안 맞음"
 },
