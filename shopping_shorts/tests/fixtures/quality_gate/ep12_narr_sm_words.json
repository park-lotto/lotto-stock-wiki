"narr": [
{
"id": "N1",
"tts": "비행기에서 투명해진 마스크팩에 놀란 외국인이 있는데요."
},
{
"id": "N2",
"tts": "처음엔 하얗던 마스크가 시간이 갈수록 비치더니,"
},
{
"id": "N3",
"tts": "세럼이 피부로 스며들수록 투명해지는 원리라는데,"
},
{
"id": "N4",
"tts": "다른 외국인 모녀는 아예 밤새 붙이고 잤더니,"
},
{
"id": "N5",
"tts": "써 본 사람들은 통째로 떨어지는 게 신기하다던데,"
},
{
"id": "N6",
"tts": "아침에 일어나도 피부가 촉촉하다고 하고."
},
{
"id": "N7",
"tts": "아, 나도 다음 비행기에선 이거 붙이고 자야겠다."
}
],
