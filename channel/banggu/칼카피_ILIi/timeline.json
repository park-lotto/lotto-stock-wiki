{
 "steps": [
  {
   "text": "아웃백이 끝까지 안 내놓은 영업기밀",
   "chars": 15,
   "new_cut": true,
   "sent": 0,
   "t0": 0.0,
   "t1": 1.804
  },
  {
   "text": "아웃백 하면 다들 떠올리는",
   "chars": 11,
   "new_cut": true,
   "sent": 1,
   "t0": 1.804,
   "t1": 3.127
  },
  {
   "text": "아웃백 하면 다들 떠올리는\n부시맨브레드",
   "chars": 6,
   "new_cut": false,
   "sent": 1,
   "t0": 3.127,
   "t1": 3.848
  },
  {
   "text": "물 한 컵 넣고 데우는",
   "chars": 8,
   "new_cut": true,
   "sent": 2,
   "t0": 3.848,
   "t1": 5.076
  },
  {
   "text": "물 한 컵 넣고 데우는\n렌지 꿀팁까지 퍼졌지만",
   "chars": 10,
   "new_cut": false,
   "sent": 2,
   "t0": 5.076,
   "t1": 6.506
  },
  {
   "text": "집에선 그 맛이",
   "chars": 6,
   "new_cut": true,
   "sent": 2,
   "t0": 6.506,
   "t1": 7.088
  },
  {
   "text": "집에선 그 맛이\n안 난다는 사람이 많았는데",
   "chars": 11,
   "new_cut": false,
   "sent": 2,
   "t0": 7.088,
   "t1": 8.411
  },
  {
   "text": "사실 빵은 똑같고",
   "chars": 7,
   "new_cut": true,
   "sent": 3,
   "t0": 8.411,
   "t1": 9.425
  },
  {
   "text": "사실 빵은 똑같고\n차이는 같이 나오는",
   "chars": 8,
   "new_cut": false,
   "sent": 3,
   "t0": 9.425,
   "t1": 10.215
  },
  {
   "text": "망고 스프레드에",
   "chars": 7,
   "new_cut": true,
   "sent": 3,
   "t0": 10.215,
   "t1": 11.231
  },
  {
   "text": "망고 스프레드에\n있었다는 거임",
   "chars": 6,
   "new_cut": false,
   "sent": 3,
   "t0": 11.231,
   "t1": 12.309
  },
  {
   "text": "문제는 아웃백이",
   "chars": 7,
   "new_cut": true,
   "sent": 4,
   "t0": 12.309,
   "t1": 12.996
  },
  {
   "text": "문제는 아웃백이\n이 스프레드를",
   "chars": 6,
   "new_cut": false,
   "sent": 4,
   "t0": 12.996,
   "t1": 14.374
  },
  {
   "text": "매장 밖에선 따로",
   "chars": 7,
   "new_cut": true,
   "sent": 4,
   "t0": 14.374,
   "t1": 15.061
  },
  {
   "text": "매장 밖에선 따로\n팔지 않는다는 거",
   "chars": 7,
   "new_cut": false,
   "sent": 4,
   "t0": 15.061,
   "t1": 15.903
  },
  {
   "text": "빵돌이들은 결국",
   "chars": 7,
   "new_cut": true,
   "sent": 5,
   "t0": 15.903,
   "t1": 16.745
  },
  {
   "text": "빵돌이들은 결국\n버터 200그램에",
   "chars": 8,
   "new_cut": false,
   "sent": 5,
   "t0": 16.745,
   "t1": 17.888
  },
  {
   "text": "망고랑 연유를",
   "chars": 6,
   "new_cut": true,
   "sent": 5,
   "t0": 17.888,
   "t1": 18.609
  },
  {
   "text": "망고랑 연유를\n120그램씩 갈아 넣어 버림",
   "chars": 12,
   "new_cut": false,
   "sent": 5,
   "t0": 18.609,
   "t1": 20.128
  },
  {
   "text": "심지어 만들다 지친",
   "chars": 8,
   "new_cut": true,
   "sent": 6,
   "t0": 20.128,
   "t1": 21.171
  },
  {
   "text": "심지어 만들다 지친\n사람들은 아예",
   "chars": 6,
   "new_cut": false,
   "sent": 6,
   "t0": 21.171,
   "t1": 22.268
  },
  {
   "text": "시판 스프레드로",
   "chars": 7,
   "new_cut": true,
   "sent": 6,
   "t0": 22.268,
   "t1": 23.028
  },
  {
   "text": "시판 스프레드로\n갈아탔다는데",
   "chars": 6,
   "new_cut": false,
   "sent": 6,
   "t0": 23.028,
   "t1": 23.784
  },
  {
   "text": "결국 아웃백 영업기밀은",
   "chars": 10,
   "new_cut": true,
   "sent": 7,
   "t0": 23.784,
   "t1": 25.121
  },
  {
   "text": "결국 아웃백 영업기밀은\n빵 말고 버터였다고ㅋㅋ",
   "chars": 10,
   "new_cut": false,
   "sent": 7,
   "t0": 25.121,
   "t1": 26.323
  }
 ],
