[Unit]
Description=Shopping Shorts continuous effect mining scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/lotto-stock-wiki
EnvironmentFile=/etc/shopping-shorts.env
Environment=EFFECT_MINING_DB=/var/lib/shopping-shorts-effect-mining/mining.db
Environment=EFFECT_MINING_MEDIA_ROOT=/var/lib/shopping-shorts-effect-mining/media
ExecStart=/usr/bin/python3 -m shopping_shorts.effect_mining.cli schedule --poll-sec 15
Restart=always
RestartSec=5
UMask=0027

[Install]
WantedBy=multi-user.target

