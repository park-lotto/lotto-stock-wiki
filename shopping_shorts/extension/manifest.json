{
  "manifest_version": 3,
  "name": "로또 · 원클릭 담기",
  "version": "1.1.0",
  "description": "유튜브·틱톡·인스타그램·샤오홍슈·도우인 영상에 '담기' 버튼을 추가해, 마음에 든 영상을 내 모음집에 클릭 한 번으로 저장합니다.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://shoppingshorts.duckdns.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.tiktok.com/*",
        "https://*.instagram.com/*",
        "https://*.xiaohongshu.com/*",
        "https://*.rednote.com/*",
        "https://*.douyin.com/*",
        "https://*.iesdouyin.com/*",
        "https://shoppingshorts.duckdns.org/*"
      ],
      "js": [
        "content.js",
        "grab_logic.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.douyin.com/*",
        "https://*.iesdouyin.com/*"
      ],
      "js": [
        "douyin_main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "로또 · 원클릭 담기",
    "default_popup": "popup.html"
  }
}