 "Is1bwCs2nmE": {
  "total": 29.5,
  "speech": 29.4,
  "foreign": 0,
  "segs": [
   {
    "s": 0.0,
    "e": 2.3,
    "lang": "ko",
    "p": 0.99,
    "ko_text": "수백만 부모들 육태를 앞당긴 통자민형의 비밀"
   },
   {
    "s": 2.3,
    "e": 4.5,
    "lang": "ko",
    "p": 0.99,
    "ko_text": "겉보기엔 흔해 빠진 애착인형처럼 보이지만"
   },
   {
    "s": 4.5,
    "e": 9.0,
    "lang": "ko",
    "p": 1.0,
    "ko_text": "사실 미국 전문가들이 아기 수면 패턴만 미친 듯이 연구해서 만든 요가템의"
   },
   {
    "s": 9.0,
    "e": 12.1,
    "lang": "ko",
    "p": 1.0,
    "ko_text": "보통 아기들은 엄마가 옆에서 자는 척만 해도 세상 편하게 잠든"
   },
   {
    "s": 12.1,
    "e": 15.6,
    "lang": "ko",
    "p": 1.0,
    "ko_text": "문제는 엄마가 빠져나오는 순간 귀신같이 알아채고 사이를 놀린다는 거"
   },
   {
    "s": 15.6,
    "e": 18.4,
    "lang": "ko",
    "p": 0.99,
    "ko_text": "하지만 이 인형은 배가 사람처럼 천천히 오르락 내리락하고"
   },
   {
    "s": 18.4,
    "e": 21.4,
    "lang": "ko",
    "p": 1.0,
    "ko_text": "심장 박동 소리, 코고는 소리까지 커스터마이징 가능해서"
   },
   {
    "s": 21.4,
    "e": 23.7,
    "lang": "ko",
    "p": 1.0,
    "ko_text": "마치 엄마 옆에서 자는 듯한 착각을 심어주니까"
   },
   {
    "s": 23.7,
    "e": 25.8,
    "lang": "ko",
    "p": 1.0,
    "ko_text": "툭하면 깨달아기의 수면 루틴을 도와주고"
   },
   {
    "s": 25.8,
    "e": 29.4,
    "lang": "ko",
    "p": 0.99,
    "ko_text": "어둠 속에 숨죽이던 부모들의 육탭까지 앞당겨졌다고 댓글 아무거나 남겨주세"
   }
  ]
 },
 "RwK7XEkemg8": {
