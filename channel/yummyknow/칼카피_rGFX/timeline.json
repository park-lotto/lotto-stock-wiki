{
 "steps": [
  {
   "text": "한국인이 비벼버린",
   "chars": 8,
   "new_cut": true,
   "sent": 0,
   "t0": 0.0,
   "t1": 1.225
  },
  {
   "text": "한국인이 비벼버린\n두바이 스프레드 얘기 아는 사람?",
   "chars": 14,
   "new_cut": false,
   "sent": 0,
   "t0": 1.225,
   "t1": 3.137
  },
  {
   "text": "얼마 전 코스트코가 진한",
   "chars": 10,
   "new_cut": true,
   "sent": 1,
   "t0": 3.137,
   "t1": 4.274
  },
  {
   "text": "얼마 전 코스트코가 진한\n초코 크림이랑 고소한",
   "chars": 9,
   "new_cut": false,
   "sent": 1,
   "t0": 4.274,
   "t1": 5.297
  },
  {
   "text": "피스타치오 크림을 큰 통",
   "chars": 10,
   "new_cut": true,
   "sent": 1,
   "t0": 5.297,
   "t1": 6.434
  },
  {
   "text": "피스타치오 크림을 큰 통\n하나에 딱 반반으로 나눠",
   "chars": 10,
   "new_cut": false,
   "sent": 1,
   "t0": 6.434,
   "t1": 7.683
  },
  {
   "text": "담아서 내놨는데",
   "chars": 7,
   "new_cut": true,
   "sent": 1,
   "t0": 7.683,
   "t1": 8.652
  },
  {
   "text": "막상 사 먹은 사람들",
   "chars": 8,
   "new_cut": true,
   "sent": 2,
   "t0": 8.652,
   "t1": 9.561
  },
  {
   "text": "막상 사 먹은 사람들\n사이에선 피스타치오",
   "chars": 9,
   "new_cut": false,
   "sent": 2,
   "t0": 9.561,
   "t1": 10.404
  },
  {
   "text": "맛은 거의 안 나고 그냥",
   "chars": 9,
   "new_cut": true,
   "sent": 2,
   "t0": 10.404,
   "t1": 11.775
  },
  {
   "text": "맛은 거의 안 나고 그냥\n흔한 초코 맛이라는 말이 돌았다고 함.",
   "chars": 16,
   "new_cut": false,
   "sent": 2,
   "t0": 11.775,
   "t1": 14.315
  },
  {
   "text": "근데 알고 보니 두 크림",
   "chars": 9,
   "new_cut": true,
   "sent": 3,
   "t0": 14.315,
   "t1": 15.338
  },
  {
   "text": "근데 알고 보니 두 크림\n맛을 각각 따로 즐기라고",
   "chars": 10,
   "new_cut": false,
   "sent": 3,
   "t0": 15.338,
   "t1": 16.475
  },
  {
   "text": "일부러 통 안에서 반반",
   "chars": 9,
   "new_cut": true,
   "sent": 3,
   "t0": 16.475,
   "t1": 17.498
  },
  {
   "text": "일부러 통 안에서 반반\n나눠 담은 거였다는데",
   "chars": 9,
   "new_cut": false,
   "sent": 3,
   "t0": 17.498,
   "t1": 18.78
  },
  {
   "text": "비빔밥의 민족답게 다들",
   "chars": 10,
   "new_cut": true,
   "sent": 4,
   "t0": 18.78,
   "t1": 19.917
  },
  {
   "text": "비빔밥의 민족답게 다들\n통째로 숟가락으로",
   "chars": 8,
   "new_cut": false,
   "sent": 4,
   "t0": 19.917,
   "t1": 20.827
  },
  {
   "text": "휘저어 버리니까 진한",
   "chars": 9,
   "new_cut": true,
   "sent": 4,
   "t0": 20.827,
   "t1": 21.85
  },
  {
   "text": "휘저어 버리니까 진한\n초코가 피스타치오 향을",
   "chars": 10,
   "new_cut": false,
   "sent": 4,
   "t0": 21.85,
   "t1": 22.987
  },
  {
   "text": "싹 다 덮어버렸다는 것.",
   "chars": 10,
   "new_cut": true,
   "sent": 4,
   "t0": 22.987,
   "t1": 24.644
  },
  {
   "text": "댓글에선 떠서 빵에 따로",
   "chars": 10,
   "new_cut": true,
   "sent": 5,
   "t0": 24.644,
   "t1": 25.891
  },
  {
   "text": "댓글에선 떠서 빵에 따로\n올려 먹는 게 정석이라는",
   "chars": 10,
   "new_cut": false,
   "sent": 5,
   "t0": 25.891,
   "t1": 27.028
  },
  {
   "text": "쪽이랑 저걸 어떻게 안",
   "chars": 9,
   "new_cut": true,
   "sent": 5,
   "t0": 27.028,
   "t1": 28.051
  },
  {
   "text": "쪽이랑 저걸 어떻게 안\n섞냐는 쪽으로 의견이 확 갈렸다고 함.",
   "chars": 16,
   "new_cut": false,
   "sent": 5,
   "t0": 28.051,
   "t1": 30.0
  }
 ],
