# ~/.codex/config.toml — 사무실 PC(2026-09-11 실측)와 같은 권한·모델 설정
# install.ps1 이 __PROJECT_DIR_LOWER__ 를 실제 저장소 경로(소문자)로 바꿔 ~/.codex/config.toml 에 쓴다.
# 플러그인(chrome/browser/computer-use)·MCP(node_repl)·notify 블록은 일부러 뺐다 —
# 그 블록들은 Codex가 첫 실행 때 그 PC 기준 절대경로로 스스로 만든다. 옛 PC 경로를 옮기면 깨진다.

# 두뇌. 사무실 PC는 지금 gpt-6-astra(어려운 일용)를 기본으로 두고 있다.
# 평소용으로 바꾸려면 아래를 "gpt-5.6-sol" 로. 대화 중엔 /model 로 언제든 바꿀 수 있다.
model = "gpt-6-astra"
model_reasoning_effort = "medium"

# 승인 창 끄기. 샌드박스 자체는 아래 [windows] 가 정한다.
approval_policy = "never"

# 이름 그대로 '위험한 전체 접근' — 작업 폴더 밖까지 묻지 않고 건드린다(사무실 PC 실측값).
# 안전하게 두려면 이 줄을 주석 처리하면 된다(그러면 workspace-write = 작업 폴더 안에서만 쓰기).
default_permissions = ":danger-full-access"

[windows]
# 권한 상승 샌드박스 — codex 를 처음 띄우면 "1. Set up default sandbox" 를 고르고 관리자 창에서 '예'.
sandbox = "elevated"

[projects.'__PROJECT_DIR_LOWER__']
trust_level = "trusted"
