   },
   {
    "kind": "장소",
    "text": "술 안 좋아하는 사람들한테까지 입소문이 나면서 요즘 전세계적으로 불티나게 팔리고 있대요.",
    "skel": "{타겟2}한테까지 입소문이 나면서 요즘 {장소}적으로 불티나게 팔리고 있대요."
   },
   {
    "kind": "전문가·직업",
    "text": "이게 천재 로목공학자가 만든 고양이 털관리 기계라는데",
    "skel": "이게 {modifier} {전문가}가 만든 {제품}이라는데"
   },
   {
    "kind": "전문가·직업",
    "text": "그래서 개발자가 고양이 행동습상을 굉유하게 이용했는데",
    "skel": "그래서 {인물}이 {대상} 행동습성을 특이하게 이용했는데"
   },
   {
    "kind": "회사·브랜드",
    "text": "다이아몬드를 갈아서 샤프심에 때려박아 색연필을 만들어버린 미친 일본 회사가 있어요.",
    "skel": "{소재}를 갈아서 {제품}에 때려박아 {신제품}을 만들어버린 {modifier} {회사}가 있어요."
   },
   {
    "kind": "회사·브랜드",
    "text": "근데 일본에서 문구르로 1등한 미쓰비시에서",
    "skel": "근데 {장소}에서 {분야}로 1등한 {브랜드}에서"
   },
   {
    "kind": "수치",
    "text": "샤프심에 나노 다이아몬드를 4억 개나 넣어 강도를 40%나 올려버렸는데",
    "skel": "{제품}에 {소재}를 {수치1}나 넣어 {성능}을 {수치2}나 올려버렸는데"
   },
   {
    "kind": "전문가·직업",
    "text": "요즘은 미대생들까지 미끄린 그릴 때 이걸로 쓴대요.",
    "skel": "요즘은 {전문가}들까지 {용도} 그릴 때 이걸로 쓴대요."
   },
   {
    "kind": "전문가·직업",
    "text": "선제개발자가 만들어서 백악웅들이 난리 났다는 배수구 트랩이 있어요.",
    "skel": "{인물}가 만들어서 {사람들}이 난리 났다는 {제품}이 있어요."
   },
   {
    "kind": "전문가·직업",
    "text": "수면 뇌과학을 연구하던 어느 대학생이",
    "skel": "{분야}를 연구하던 어느 {인물}이"
