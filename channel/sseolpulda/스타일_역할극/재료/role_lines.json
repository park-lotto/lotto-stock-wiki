    "cps": 5.78
   }
  },
  "turns": 6,
  "dialog_char_share": 0.367,
  "dialog_lines": 3,
  "dialog_line_sec": [
   2.97,
   2.25,
   5.73
  ],
  "first_dialog_at": 6.26,
  "lines": [
   {
    "role": "나레",
    "start": 0.05,
    "end": 6.26,
    "chars": 51,
    "text": "삼성 내부에서도 난리 났더니 폴드팔에 미친 속사정 원래 삼성은 기존 폴더블 라인업만 유지 하려했는데 개발팀 한 엔지니어가"
   },
   {
    "role": "엔지니어",
    "start": 6.26,
    "end": 9.23,
    "chars": 23,
    "text": "가로로 넓은 하면 안 만들면 올해 애플한테 다 빼앗깁니다"
   },
   {
    "role": "나레",
    "start": 9.23,
    "end": 13.28,
    "chars": 31,
    "text": "며 원가를 무시한채 가루형 폴드파를 강행 해버린거임 이에 당황한 경영진이"
   },
   {
    "role": "경영진",
    "start": 13.28,
    "end": 15.53,
    "chars": 13,
    "text": "아니 부품 단가는 어떡할 거냐고"
   },
   {
    "role": "나레",
    "start": 15.56,
    "end": 16.4,
    "chars": 6,
    "text": "고 쏘아붙이자"
   },
   {
    "role": "엔지니어",
    "start": 16.43,
    "end": 22.16,
    "chars": 47,
    "text": "올해 나올 폴더블 아이폰 화면도 어차피 우리가 만들거니까 똑같은 디스플레이 얹어서 싹 다 찍어내면 단가 떡락해요"
   },
   {
    "role": "나레",
    "start": 22.19,
    "end": 29.18,
    "chars": 55,
    "text": "이라는 미친 한수를 던져버렸다는 거 진짜 소름 돋는 포인트는 폴드팔에 적용된 화면이 가로로 넓어져 영상 볼 때 몰입감이 미쳐버린다고"
   }
  ]
 },
