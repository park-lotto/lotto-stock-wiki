 "titles": {
  "hook": "걷기만 하면 굴러가는\nAI 전동 신발"
 },
 "facts": {
  "f1": {
   "text": "4~9초 책상 위 일반 운동화 옆 바퀴 달린 전동 신발(Shift 로고) · 0~9.4 'this is a … AI-powered motorized electric shoe'(가격 말은 안 씀)",
   "kind": "화면+본인 말"
  },
  "f2": {
   "text": "76.6~80.6 'To turn them on I have to like twist my foot like Dorothy in the Wizard of Oz' · 81~82 신발 근접",
   "kind": "본인 말+화면"
  },
  "f3": {
   "text": "89.45~92.05 'Oh my god, they're moving.' · 110.2~115.7 'It feels like you're riding roller skates on ice and like someone's pushing you.'",
   "kind": "본인 말"
  },
  "f4": {
   "text": "129~148 친구가 신고 걸음 · 140.9~143.5 (친구) 'Yeah, now they're going. Whoa.'",
   "kind": "화면+말"
  },
  "f5": {
   "text": "182.9~202.7 'there's no controller or anything. You make these things go by walking, and then the AI within the shoes figures out how fast you want to be going'",
   "kind": "본인 말+화면(신발 손에 끼움)"
  },
  "f6": {
   "text": "30.4~35 'They announced these things on Kickstarter six months ago and it went viral' · 40.5~45.5 기사 화면 'Walking With AI'·'These battery-powered shoes make you walk 2.5 times faster'·'Walk 250% Faster'",
   "kind": "본인 말+화면 글자"
  },
  "f7": {
   "text": "165.9~169.8 'I feel like I'm at least two and a half times faster.'(두 모델 받아쓰기, 앞 낱말만 'They're like'로 한 번 갈림)",
   "kind": "본인 말"
  }
 },
