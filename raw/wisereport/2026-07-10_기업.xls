		<style type="text/css">
			td { FONT: 11px '맑은 고딕'; COLOR: #333333; border-top:none;border-bottom:0.5pt solid rgb(209,209,209);}
			br {mso-data-placement:same-cell;}
			body { PADDING-RIGHT: 0px; PADDING-LEFT: 0px; PADDING-BOTTOM: 0px; MARGIN: 0px; FONT: 9pt '맑은 고딕'; PADDING-TOP: 0px }
			form { PADDING-RIGHT: 0px; PADDING-LEFT: 0px; PADDING-BOTTOM: 0px; MARGIN: 0px; FONT: 9pt '맑은 고딕'; PADDING-TOP: 0px }
			.title{font:bold 14pt 'HY견고딕';color:rgb(47,71,107)}
			.hd { font: bold 9pt '맑은 고딕'; color: rgb(53,91,157); height: 30px; background-color: rgb(247,247,247); text-align: center;border-top:1px rgb(47,71,107) solid}
			.strdeg{mso-width-source:userset;width:80px;height: 24px;text-align: left}
			.pre_recomm{mso-width-source:userset;width:80px;height: 24px;text-align: left}
			.recomm{width:80px;height: 24px;text-align: left}
			.brk{mso-width-source:userset;width:110px;height: 24px;text-align: left}
			.cmp,.ind{mso-width-source:userset;width:90px;height: 24px;text-align: left}
			.strprc{mso-width-source:userset;width:60px;height: 24px;text-align: right}
			.pre_targer_prc{mso-width-source:userset;width:60px;height: 24px;text-align: right}
			.close_prc{mso-width-source:userset;width:80px;height: 24px;text-align: right}
			.comment{width:500px;height: 49px;}
			.comment2{width:450px;height: 49px;}
			.rpt_title{width:275px;height:24px;text-align: left}
			.img0{width:20px;height:30px;line-height:30px;font-size:11pt;font-family:'HY견고딕';font-weight:bold;color:rgb(101,102,102)}
			.img1{width:20px;height:30px;line-height:30px;font-size:7pt;font-family:'맑은 고딕';color:rgb(254,1,10)}
			.img2{width:20px;height:30px;line-height:30px;font-size:11pt;font-family:'맑은 고딕';font-weight:bold;color:rgb(14,152,15)}
			.img3{width:20px;height:30px;line-height:30px;font-size:7pt;font-family:'맑은 고딕';color:rgb(52,101,254)}
			.img4{width:20px;height:30px;line-height:30px;font-size:9pt;font-family:'맑은 고딕';font-weight:bold;color:rgb(254,1,10)}
			@page
	            {mso-header-data:"&R리포트서머리";
	            mso-footer-data:"Page &P of &N";
	            margin:.5in 0in .4in 0in;
	            mso-header-margin:.31in;
	            mso-footer-margin:.2in;
	            mso-page-orientation:landscape;}
		</style>
