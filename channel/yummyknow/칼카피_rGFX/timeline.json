{
 "steps": [
  {
   "text": "코스트코 두바이 초콜릿",
   "chars": 10,
   "new_cut": true,
   "sent": 0,
   "t0": 0.0,
   "t1": 1.423
  },
  {
   "text": "코스트코 두바이 초콜릿\n스프레드, 사기 전에",
   "chars": 9,
   "new_cut": false,
   "sent": 0,
   "t0": 1.423,
   "t1": 2.415
  },
  {
   "text": "알아둘 게 있음.",
   "chars": 7,
   "new_cut": true,
   "sent": 0,
   "t0": 2.415,
   "t1": 3.416
  },
  {
   "text": "코스트코 코리아가",
   "chars": 8,
   "new_cut": true,
   "sent": 1,
   "t0": 3.416,
   "t1": 4.297
  },
  {
   "text": "코스트코 코리아가\n누스포 두바이 초콜릿",
   "chars": 9,
   "new_cut": false,
   "sent": 1,
   "t0": 4.297,
   "t1": 5.289
  },
  {
   "text": "크림 스프레드를 1kg",
   "chars": 10,
   "new_cut": true,
   "sent": 1,
   "t0": 5.289,
   "t1": 6.391
  },
  {
   "text": "크림 스프레드를 1kg\n통으로 내놨는데",
   "chars": 7,
   "new_cut": false,
   "sent": 1,
   "t0": 6.391,
   "t1": 7.163
  },
  {
   "text": "피스타치오 크림 속",
   "chars": 8,
   "new_cut": true,
   "sent": 2,
   "t0": 7.163,
   "t1": 8.045
  },
  {
   "text": "피스타치오 크림 속\n카다이프가 씹혀서",
   "chars": 8,
   "new_cut": false,
   "sent": 2,
   "t0": 8.045,
   "t1": 9.289
  },
  {
   "text": "바삭한 게 특징이고",
   "chars": 8,
   "new_cut": true,
   "sent": 2,
   "t0": 9.289,
   "t1": 9.997
  },
  {
   "text": "바삭한 게 특징이고\n정가",
   "chars": 2,
   "new_cut": false,
   "sent": 2,
   "t0": 9.997,
   "t1": 10.297
  },
  {
   "text": "17,990원에서",
   "chars": 9,
   "new_cut": true,
   "sent": 2,
   "t0": 10.297,
   "t1": 11.209
  },
  {
   "text": "17,990원에서\n3,000원 할인한",
   "chars": 9,
   "new_cut": false,
   "sent": 2,
   "t0": 11.209,
   "t1": 12.201
  },
  {
   "text": "14,990원에 팔았던 것.",
   "chars": 13,
   "new_cut": true,
   "sent": 2,
   "t0": 12.201,
   "t1": 13.829
  },
  {
   "text": "코스트코 상품",
   "chars": 6,
   "new_cut": true,
   "sent": 3,
   "t0": 13.829,
   "t1": 14.491
  },
  {
   "text": "코스트코 상품\n페이지에는 리뷰",
   "chars": 7,
   "new_cut": false,
   "sent": 3,
   "t0": 14.491,
   "t1": 15.262
  },
  {
   "text": "28개에 평점 4.7이 찍혀 있음.",
   "chars": 15,
   "new_cut": true,
   "sent": 3,
   "t0": 15.262,
   "t1": 17.098
  },
  {
   "text": "근데 뚜껑을 열면",
   "chars": 7,
   "new_cut": true,
   "sent": 4,
   "t0": 17.098,
   "t1": 17.869
  },
  {
   "text": "근데 뚜껑을 열면\n헤이즐넛 크림과",
   "chars": 7,
   "new_cut": false,
   "sent": 4,
   "t0": 17.869,
   "t1": 18.641
  },
  {
   "text": "피스타치오 크림이",
   "chars": 8,
   "new_cut": true,
   "sent": 4,
   "t0": 18.641,
   "t1": 19.523
  },
  {
   "text": "피스타치오 크림이\n반반씩 나뉘어 담겨 있는데",
   "chars": 11,
   "new_cut": false,
   "sent": 4,
   "t0": 19.523,
   "t1": 20.735
  },
  {
   "text": "보관 온도에 따라 층이",
   "chars": 9,
   "new_cut": true,
   "sent": 5,
   "t0": 20.735,
   "t1": 21.727
  },
  {
   "text": "보관 온도에 따라 층이\n분리될 수 있지만 품질엔",
   "chars": 10,
   "new_cut": false,
   "sent": 5,
   "t0": 21.727,
   "t1": 23.057
  },
  {
   "text": "문제없으니 잘 저어",
   "chars": 8,
   "new_cut": true,
   "sent": 5,
   "t0": 23.057,
   "t1": 23.939
  },
  {
   "text": "문제없으니 잘 저어\n먹으라고 적혀 있고",
   "chars": 8,
   "new_cut": false,
   "sent": 5,
   "t0": 23.939,
   "t1": 24.632
  },
  {
   "text": "100g에",
   "chars": 5,
   "new_cut": true,
   "sent": 5,
   "t0": 24.632,
   "t1": 25.559
  },
  {
   "text": "100g에\n540kcal",
   "chars": 7,
   "new_cut": false,
   "sent": 5,
   "t0": 25.559,
   "t1": 26.293
  },
  {
   "text": "당류 48.3g이라 한",
