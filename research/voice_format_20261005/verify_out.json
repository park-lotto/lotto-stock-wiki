 "BbLQv_nVAAE": {
  "distinct_second_voice": true,
  "same_person_tone_change": false,
  "lines": [
   {
    "t": 4.78,
    "text": "너는 유아야. 너는 그냥 최지유로 할 거야.",
    "kind": "원음"
   },
   {
    "t": 7.62,
    "text": "근데 니나는 에이나가 될 거야.",
    "kind": "원음"
   },
   {
    "t": 9.22,
    "text": "어?",
    "kind": "리액션"
   },
   {
    "t": 10.52,
    "text": "와",
    "kind": "리액션"
   },
   {
    "t": 15.0,
    "text": "The own 링링이라고 알렉스 엑설 밀리 모아 영원",
    "kind": "원음"
   },
   {
    "t": 22.0,
    "text": "좋아하는 색깔을 그 앞에 동물을 붙여 가지고 트루가고 있습니다. 고맙습니다.",
    "kind": "원음"
   },
   {
    "t": 29.32,
    "text": "어떻게 하는 거야?",
    "kind": "리액션"
   }
  ]
 },
 "Rq2f7G_495M": {
  "distinct_second_voice": false,
  "same_person_tone_change": true,
  "lines": [
   {
    "t": 0,
    "text": "이사배가 드디어 구독자 수준을 이해했다는데",
    "kind": "원음"
   },
   {
    "t": 1,
    "text": "커버를 좀 신경 쓰는 편이에요",
    "kind": "원음"
   },
   {
    "t": 3,
    "text": "라고 하신다면",
    "kind": "원음"
   },
   {
    "t": 4,
    "text": "그런 걸 쓰시면 좋은데",
    "kind": "원음"
   },
   {
    "t": 5,
    "text": "안 쓰실 거잖아요.",
    "kind": "원음"
   },
   {
    "t": 7,
    "text": "그래서 가져온 왕초보 꿀템이 있다고.",
    "kind": "원음"
   },
   {
    "t": 9,
    "text": "이거 완전 짐승 용량이에요.",
    "kind": "원음"
   },
   {
    "t": 11,
    "text": "많이 쓸 수 있는 거라서",
    "kind": "원음"
   },
   {
    "t": 13,
    "text": "특히 브러시도 여러 개 쓰면 좋지만",
    "kind": "원음"
   },
   {
    "t": 15,
    "text": "안 쓰실 거잖아요?",
    "kind": "원음"
   },
   {
    "t": 16,
    "text": "그럼 그냥 도장 브러시 쓰세요. 이게 제일 쉬워요.",
    "kind": "원음"
   }
  ]
 },
 "VuslousJ0BY": {
  "distinct_second_voice": true,
  "same_person_tone_change": false,
  "lines": [
   {
    "t": 4,
    "text": "천재야 천재. 나도 따라 해볼래.",
    "kind": "리액션"
   },
   {
    "t": 11,
    "text": "끈을 고리에 통과시켜 당겨서 조여줘.",
    "kind": "리액션"
   },
   {
    "t": 17,
    "text": "큰 고리를 반대쪽으로 넘겨서 작은 고리를 올리고",
    "kind": "리액션"
   },
   {
    "t": 24,
    "text": "작은 고리 사이로 끈을 들어 올리면 우와 엄청 쉬운데?",
    "kind": "리액션"
   }
  ]
 },
 "YDFC0LmrW0Y": {
  "distinct_second_voice": true,
  "same_person_tone_change": false,
  "lines": [
   {
    "t": 5.2,
    "text": "어 저는 해요 매일.",
    "kind": "원음"
   },
   {
    "t": 8.3,
    "text": "그 비누 있어요. 얼굴이 안 가려워요.",
    "kind": "원음"
   },
   {
    "t": 16.3,
    "text": "그거는 제가 어시 때 비누로 엄청 많이 테스트했는데 그때 찾았던 비누여서 10년 이상 쓰고 있어요.",
    "kind": "원음"
   },
   {
    "t": 22.2,
    "text": "브러쉬도 얼굴이 하나도 안 가려요.",
    "kind": "원음"
   }
  ]
 },
 "dCn16ZJGSqs": {
  "distinct_second_voice": true,
  "same_person_tone_change": false,
  "lines": [
   {
    "t": 2,
    "text": "와!",
    "kind": "리액션"
   },
   {
    "t": 5,
    "text": "뭐? 제발!",
    "kind": "리액션"
   },
   {
    "t": 9,
    "text": "아 예?",
    "kind": "리액션"
   },
   {
    "t": 10,
    "text": "아 저거는 좀 무서운데.",
    "kind": "리액션"
   },
   {
    "t": 13,
    "text": "매매값이라고요?",
    "kind": "리액션"
   },
   {
    "t": 15,
    "text": "심지어 방 개수 세 개랑 욕실 두 개인데요?",
    "kind": "리액션"
   },
   {
    "t": 17,
    "text": "아 저건 그건 안 될 거 같아.",
    "kind": "리액션"
   },
   {
    "t": 19,
    "text": "왜 이러다 테라포밍까지 하겠어.",
    "kind": "리액션"
   },
   {
    "t": 21,
    "text": "해줘.",
    "kind": "리액션"
   }
  ]
 },
