[Unit]
# 부팅할 때 워커 수를 코어 수에 맞춘다(2026-08-22).
#
# 증설은 스냅샷→새 인스턴스라, 새 서버는 옛 설정(워커 3개)을 그대로 물고 뜬다.
# 사람이 스크립트를 기억해 돌려야 하면 언젠가 잊는다 → 부팅에 묶어 자동으로 만든다.
#
# ★설치(현재 서버에서 미리 해둬야 스냅샷에 딸려간다):
#     sudo cp deploy/shopping-shorts-workers.service /etc/systemd/system/
#     sudo systemctl daemon-reload
#     sudo systemctl enable shopping-shorts-workers.service
#     sudo systemctl start  shopping-shorts-workers.service     # 지금 한 번 적용
Description=워커 수를 코어 수에 맞춘다 (증설 후 자동 반영)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# 스크립트가 git으로 배포되므로 프로젝트 폴더의 것을 그대로 쓴다 —
# /etc 아래로 복사해두면 코드를 고쳐도 옛 사본이 돌아 어긋난다(0순위-B).
ExecStart=/bin/bash /home/ubuntu/lotto-stock-wiki/deploy/worker_autoscale.sh
# systemctl enable/start 를 부르므로 root로 돈다.
User=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
