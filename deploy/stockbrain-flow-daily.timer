[Unit]
Description=종목별 일별 수급 적재 타이머(장 마감 후 18:30·22:00 KST)

[Timer]
# 서버 시간대 기준(KST). 장 마감(15:30) 후 확정 수급이 올라오는 시각을 노린다.
# 두 번 도는 이유: 한 번 실패해도 같은 날 안에 회수된다.
# 스크립트가 매번 30거래일을 통째로 덮어쓰므로 중복 실행은 무해하다(멱등).
OnCalendar=*-*-* 18:30:00
OnCalendar=*-*-* 22:00:00
# 서버가 꺼져 있어 놓친 실행은 다음 부팅 때 1회 보충.
Persistent=true

[Install]
WantedBy=timers.target
