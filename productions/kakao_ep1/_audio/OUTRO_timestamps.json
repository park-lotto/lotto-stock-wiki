{
  "scene": "OUTRO",
  "fps": 30,
  "total_frames": 914,
  "segments": [
    {
      "index": 0,
      "text": "방금 보신 이 카톡 브리핑",
      "start_frame": 0,
      "end_frame": 68,
      "start_sec": 0.0,
      "end_sec": 2.28
    },
    {
      "index": 1,
      "text": "어제 딱 10분 세팅한 게",
      "start_frame": 68,
      "end_frame": 128,
      "start_sec": 2.28,
      "end_sec": 4.28
    },
    {
      "index": 2,
      "text": "오늘 아침 그대로 온 결과예요",
      "start_frame": 128,
      "end_frame": 203,
      "start_sec": 4.28,
      "end_sec": 6.76
    },
    {
      "index": 3,
      "text": "아우",
      "start_frame": 203,
      "end_frame": 223,
      "start_sec": 6.76,
      "end_sec": 7.44
    },
    {
      "index": 4,
      "text": "한 번 만들어 두면",
      "start_frame": 223,
      "end_frame": 259,
      "start_sec": 7.44,
      "end_sec": 8.64
    },
    {
      "index": 5,
      "text": "내일도 모래도 알아서 옵니다",
      "start_frame": 259,
      "end_frame": 328,
      "start_sec": 8.64,
      "end_sec": 10.92
    },
    {
      "index": 6,
      "text": "아침마다 하던 그 번거로운 정보 수직",
      "start_frame": 328,
      "end_frame": 407,
      "start_sec": 10.92,
      "end_sec": 13.56
    },
    {
      "index": 7,
      "text": "이제 안 하셔도 돼요",
      "start_frame": 407,
      "end_frame": 454,
      "start_sec": 13.56,
      "end_sec": 15.12
    },
    {
      "index": 8,
      "text": "진짜 핵심은 다음 편이에요",
      "start_frame": 454,
      "end_frame": 524,
      "start_sec": 15.12,
      "end_sec": 17.48
    },
    {
      "index": 9,
      "text": "유료 리포트랑 텔레그랩 유튜버 얘기까지",
      "start_frame": 524,
      "end_frame": 618,
      "start_sec": 17.48,
      "end_sec": 20.6
    },
    {
      "index": 10,
      "text": "AI가 실시간으로 정리해주는 거",
      "start_frame": 618,
      "end_frame": 684,
      "start_sec": 20.6,
      "end_sec": 22.8
    },
    {
      "index": 11,
      "text": "근데 그건 오늘 이 기본 편을 세팅해 두어야",
      "start_frame": 684,
      "end_frame": 787,
      "start_sec": 22.8,
      "end_sec": 26.24
    },
    {
      "index": 12,
      "text": "따라오실 수 있어요",
      "start_frame": 787,
      "end_frame": 830,
      "start_sec": 26.24,
      "end_sec": 27.68
    },
    {
      "index": 13,
      "text": "다음 편 놓치지 않게 구독 눌러주세요",
      "start_frame": 830,
      "end_frame": 914,
      "start_sec": 27.68,
      "end_sec": 30.48
    }
  ]
}