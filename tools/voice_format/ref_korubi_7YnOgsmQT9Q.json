  {
   "t": "00:21",
   "who": "딸",
   "voice": "여자·사람·놀람",
   "text": "무슨 소리야? 패딩 10개는 더 들어가."
  },
  {
   "t": "00:22",
   "who": "딸",
   "voice": "여자·사람·흥분",
   "text": "이것 봐 부피가 거의 반으로 줄었어."
