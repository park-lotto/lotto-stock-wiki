  "transcript": {
   "model": "gemini-flash-lite-latest",
   "segments": [
    {
     "start": 1.0,
     "end": 2.5,
     "text": "요즘 미국에서",
     "speaker": "S1",
     "lang": "ko",
     "kind": "narration"
    },
    {
     "start": 2.5,
     "end": 4.5,
     "text": "환장하는 차가 있는데요.",
     "speaker": "S1",
     "lang": "ko",
     "kind": "narration"
    },
    {
     "start": 4.5,
     "end": 8.0,
     "text": "포르쉐 911 마티니를 오마주한 미니 전기차로",
     "speaker": "S1",
     "lang": "ko",
     "kind": "narration"
    },
    {
     "start": 8.0,
     "end": 10.5,
     "text": "원래는 두바이 금수저 장난감 차로 유명했는데,",
     "speaker": "S1",
     "lang": "ko",
     "kind": "narration"
    },
    {
     "start": 10.5,
     "end": 14.0,
     "text": "구독자 2,200만 슈퍼카 블론디에 소개되며 미국에서 인기 폭발.",
     "speaker": "S1",
     "lang": "ko",
     "kind": "narration"
    },
    {
     "start": 14.5,
     "end": 16.5,
     "text": "This is fun. I want one.",
     "speaker": "S1",
     "lang": "en",
     "kind": "source"
    },
    {
     "start": 17.0,
     "end": 20.0,
     "text": "3,000W 모터로 시속 80km를 쏘고,",
     "speaker": "S1",
     "lang": "ko",
     "kind": "narration"
    },
    {
     "start": 20.0,
     "end": 24.5,
     "text": "주행 거리도 40km에 심지어 유압 브레이크가 있어",
     "speaker": "S1",
     "lang": "ko",
     "kind": "narration"
    },
    {
     "start": 24.5,
     "end": 27.5,
     "text": "드리프트도 가능하고 옵션 추가 시 배기구 불꽃까지 터지는데,",
     "speaker": "S1",
     "lang": "ko",
     "kind": "narration"
    },
    {
     "start": 27.5,
     "end": 30.8,
     "text": "어디 가도 시선 강탈이라 소문자 아이는 절대 못 하겠네요.",
     "speaker": "S1",
     "lang": "ko",
     "kind": "narration"
    }
   ],
   "n": 10,
   "langs": [
    "en",
    "ko"
