# sudo cp deploy/shopping-shorts.env.example /etc/shopping-shorts.env 후 실제 값으로 채울 것
DASH_USER=admin
DASH_PASS=여기에_원하는_비번
DASH_SECRET=openssl_rand_hex_32_로_생성한_값

# raw/report_q 파이프라인과 무관 — 쇼핑쇼츠 전용 채널 리스트 엑셀 경로.
# 서버에는 scp로 직접 업로드 후 그 경로를 적는다 (Task 5 참고).
SHORTS_EXCEL=/home/ubuntu/lotto-stock-wiki/shopping_shorts/data/벤치마킹시트.xlsx

# Apify 4계정 로테이션 (2026-07-09 구현)
APIFY_TOKEN=
APIFY_TOKEN_2=
APIFY_TOKEN_3=
APIFY_TOKEN_4=

# 댓글 draft 생성 전용 Gemini 키 풀(2026-07-09) — 주식위키 본체의 공유 풀
# (pipeline.atoms.key_vault)과 완전히 분리. 여기가 소진돼도 공유 풀로
# 넘어가지 않고 그냥 다음날까지 대기(comment_gen.py 참고).
SHORTS_GEMINI_KEY=
SHORTS_GEMINI_KEY_2=
SHORTS_GEMINI_KEY_3=

# 제품찾기(기능③) 유튭 실수집용 — Google Cloud Console에서 무료 발급 (2026-07-09)
YOUTUBE_API_KEY=
# Google Lens가 우리 프레임 이미지를 fetch할 때 쓰는 절대 URL 베이스(2026-07-09)
PUBLIC_BASE_URL=https://shoppingshorts.duckdns.org
