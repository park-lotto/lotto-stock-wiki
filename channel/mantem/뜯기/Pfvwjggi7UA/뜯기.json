   "model": "gemini-3.5-flash",
   "warnings": [
    "길이 초과 16.5~19.4"
   ],
   "segments": [
    {
     "start": 0.0,
     "end": 1.05,
     "text": "이게 너무 맛있어요.",
     "speaker": "S1",
     "lang": "ko",
     "kind": "dialog"
    },
    {
     "start": 1.05,
     "end": 3.25,
     "text": "성훈이가 극찬한 역대급 간식이라는데",
     "speaker": "S2",
     "lang": "ko",
     "kind": "narration"
    },
    {
     "start": 3.25,
     "end": 4.41,
     "text": "이거 드셔보셨어요?",
     "speaker": "S3",
     "lang": "ko",
     "kind": "dialog"
    },
    {
     "start": 4.41,
     "end": 5.56,
     "text": "아우 먹어봤어요.",
     "speaker": "S1",
     "lang": "ko",
     "kind": "dialog"
    },
    {
     "start": 5.56,
     "end": 7.5,
     "text": "솔직히 말하잖아? 앉은 자리에서 다 까먹어.",
     "speaker": "S1",
     "lang": "ko",
     "kind": "dialog"
    },
    {
     "start": 7.5,
     "end": 9.71,
     "text": "그냥 먹는 거랑 이렇게 먹는 거랑 하늘과 땅 차이다.",
     "speaker": "S3",
     "lang": "ko",
     "kind": "dialog"
    },
    {
     "start": 9.71,
     "end": 11.58,
     "text": "한 번 맛보면 중독성이 미쳤다는데",
     "speaker": "S2",
     "lang": "ko",
     "kind": "narration"
    },
    {
     "start": 11.58,
     "end": 12.8,
     "text": "혼자 다 먹어도 모자랍니다.",
     "speaker": "S3",
     "lang": "ko",
     "kind": "dialog"
    },
    {
     "start": 12.8,
     "end": 14.1,
     "text": "근데 진짜 맛있더라고.",
     "speaker": "S1",
     "lang": "ko",
     "kind": "dialog"
    },
    {
     "start": 14.1,
     "end": 16.51,
     "text": "안에 보면 요거 들어있어요 요거. 꼭 요거로 까셔야 돼요.",
     "speaker": "S1",
     "lang": "ko",
     "kind": "dialog"
    },
    {
     "start": 16.51,
     "end": 19.1,
     "text": "이거 모르고 처음에 그냥 알맹이 집어넣고 이빨로 까시다가 나가니까",
     "speaker": "S1",
     "lang": "ko",
     "kind": "dialog"
    }
   ],
