[Unit]
Description=채널 전수조사 주 1회 타이머(월요일 05:10 — 유튜브 일일 수집 08:10 전, 고객이 적은 시간)
# ★auto_deploy는 타이머 파일을 설치하지 않는다 — 바꾸면 수동 cp + daemon-reload
#   sudo cp deploy/shopping-shorts-channel-survey.{service,timer} /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now shopping-shorts-channel-survey.timer

[Timer]
OnCalendar=Mon *-*-* 05:10:00
Persistent=true

[Install]
WantedBy=timers.target
