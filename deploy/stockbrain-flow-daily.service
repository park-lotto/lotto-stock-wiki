[Unit]
Description=종목별 일별 수급 적재(외국인·기관·개인 순매수)
After=network.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/lotto-stock-wiki
# ★크론이 아니라 systemd로 도는 이유:
#   KIS 키는 /etc/stockbrain.env 에 있는데 이 파일은 root:root 600이라
#   ubuntu 크론에서는 읽을 수 없다(Permission denied 실측).
#   systemd는 root가 읽어 프로세스에 넘겨주므로 권한을 낮추지 않고 해결된다.
EnvironmentFile=/etc/stockbrain.env
ExecStart=/home/ubuntu/venv/bin/python scripts/flow_daily.py
# 398종목 × 0.35초 ≈ 6분. 넉넉히 잡되 무한정 물고 있지는 않게.
TimeoutStartSec=1800
