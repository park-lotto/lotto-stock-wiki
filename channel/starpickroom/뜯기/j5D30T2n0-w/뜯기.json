   },
   "voice_tone": "활기차고 친근한 20대 여성 수다체",
   "speakers": [
    {
     "id": "S1",
     "gender": "female",
     "voice": "tts"
    }
   ]
  },
  "transcript": {
   "model": "gemini-flash-lite-latest",
   "warnings": [
    "길이 초과 28.9~30.3"
   ],
   "segments": [
    {
     "start": 0.0,
     "end": 2.62,
     "text": "새화정이 만들자마자 스텝들이 난리가 났다는데",
     "speaker": "S1",
     "lang": "ko",
     "kind": "narration"
    },
    {
     "start": 2.62,
     "end": 4.639,
     "text": "역대급이야. 진짜 너무 맛있어.",
     "speaker": "S1",
     "lang": "ko",
     "kind": "dialog"
    },
    {
     "start": 5.229,
     "end": 7.029,
     "text": "아니 이거는 비밀로 팔아야 돼요.",
     "speaker": "S1",
     "lang": "ko",
     "kind": "dialog"
    },
    {
     "start": 7.029,
     "end": 9.909,
     "text": "알고 보니 요즘 SNS에서 난리 난 레시피라는데.",
     "speaker": "S1",
     "lang": "ko",
     "kind": "narration"
    },
    {
     "start": 9.909,
     "end": 13.069,
     "text": "맞아. 나도 인스타 보고 배웠어. 감자를 잘게 잘게 썰은 거야.",
     "speaker": "S1",
     "lang": "ko",
     "kind": "dialog"
    },
    {
     "start": 13.069,
     "end": 14.939,
     "text": "오징어도 똑같은 크기로 썰었어요.",
     "speaker": "S1",
     "lang": "ko",
     "kind": "narration"
    },
    {
     "start": 14.939,
     "end": 17.399,
     "text": "그리고 여기다가 청양고추랑 홍고추.",
     "speaker": "S1",
     "lang": "ko",
     "kind": "dialog"
    },
    {
     "start": 17.659,
     "end": 18.429,
     "text": "녹말가루.",
     "speaker": "S1",
     "lang": "ko",
     "kind": "narration"
    },
    {
     "start": 18.579,
     "end": 21.579,
     "text": "맛소고 조개 액젓을 살짝 넣게.",
     "speaker": "S1",
     "lang": "ko",
     "kind": "dialog"
    },
    {
     "start": 22.189,
     "end": 24.309,
     "text": "그리고 최화정만의 킥이 있다는데.",
     "speaker": "S1",
     "lang": "ko",
     "kind": "narration"
    },
    {
     "start": 24.309,
     "end": 25.309,
     "text": "자 이거 한번 뿌려보자.",
     "speaker": "S1",
     "lang": "ko",
     "kind": "dialog"
    },
    {
     "start": 25.309,
     "end": 26.069,
     "text": "진짜 햄버거.",
     "speaker": "S1",
     "lang": "ko",
     "kind": "narration"
    },
    {
     "start": 26.069,
     "end": 27.399,
     "text": "햄버거 그 김 맛이야.",
     "speaker": "S1",
     "lang": "ko",
     "kind": "dialog"
    },
    {
     "start": 27.399,
     "end": 28.099,
     "text": "오래 발견하고.",
     "speaker": "S1",
     "lang": "ko",
     "kind": "narration"
    },
    {
     "start": 28.099,
     "end": 28.669,
     "text": "응.",
     "speaker": "S1",
