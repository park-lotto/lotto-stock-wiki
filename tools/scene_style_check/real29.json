{"ctx": {"jobId": "29109deff2a9", "text": {"channel": "숏템메이커", "hook1": "제조사도 감탄한", "hook2": "미친 거치대 활용법", "bodyTitle": "제조사도 감탄한 미친 거치대 활용법?", "supportTitle": ""}, "autoText": {"hook1": "제조사도 감탄한", "hook2": "미친 거치대 활용법", "bodyTitle": "제조사도 감탄한 미친 거치대 활용법?"}, "scenes": [{"start": 0.0, "end": 1.1456212359142897, "caption": "제조사도 감탄한", "caption_visible": true, "beat_idx": 0, "kind": "hook"}, {"start": 1.1456212359142897, "end": 2.256, "caption": "미친 거치대 활용법", "caption_visible": true, "beat_idx": 0, "kind": "hook"}, {"start": 2.256, "end": 3.9960269664296586, "caption": "카페에서 노트북 쓸 때", "caption_visible": true, "beat_idx": 1, "kind": "body"}, {"start": 3.9960269664296586, "end": 5.226487251309493, "caption": "둔탁한 거치대 때문에", "caption_visible": true, "beat_idx": 1, "kind": "body"}, {"start": 5.226487251309493, "end": 6.694778238971681, "caption": "가방만 볼록해지고", "caption_visible": true, "beat_idx": 1, "kind": "body"}, {"start": 6.694778238971681, "end": 8.579158432067203, "caption": "거추장스럽던 사람들 사이에서", "caption_visible": true, "beat_idx": 1, "kind": "body"}, {"start": 8.579158432067203, "end": 9.624, "caption": "난리가 났다는데", "caption_visible": true, "beat_idx": 1, "kind": "body"}, {"start": 9.624, "end": 10.416448915461384, "caption": "이건 바로", "caption_visible": true, "beat_idx": 2, "kind": "body"}, {"start": 10.416448915461384, "end": 11.568000000000001, "caption": "올인원 거치대", "caption_visible": true, "beat_idx": 2, "kind": "body"}, {"start": 11.568000000000001, "end": 13.01252073557648, "caption": "이게 말도 안 되는게", "caption_visible": true, "beat_idx": 3, "kind": "body"}, {"start": 13.01252073557648, "end": 14.997631780518109, "caption": "기존 둔탁한 거치대와 달리", "caption_visible": true, "beat_idx": 3, "kind": "body"}, {"start": 14.997631780518109, "end": 16.368000000000002, "caption": "가방에 넣을 때마다", "caption_visible": true, "beat_idx": 3, "kind": "body"}, {"start": 16.368000000000002, "end": 18.187501670589466, "caption": "볼록하게 튀어나와", "caption_visible": true, "beat_idx": 4, "kind": "body"}, {"start": 18.187501670589466, "end": 18.980054566263536, "caption": "짐만 되고", "caption_visible": true, "beat_idx": 4, "kind": "body"}, {"start": 18.980054566263536, "end": 21.216, "caption": "공간 다 차지하던 괴로움을", "caption_visible": true, "beat_idx": 4, "kind": "body"}, {"start": 21.216, "end": 22.56089056724362, "caption": "한 손에 딱 쥐어지는", "caption_visible": true, "beat_idx": 5, "kind": "body"}, {"start": 22.56089056724362, "end": 24.648, "caption": "일자 막대로 접어버렸다는 거", "caption_visible": true, "beat_idx": 5, "kind": "body"}, {"start": 24.648, "end": 25.568346950088277, "caption": "심지어 거기다", "caption_visible": true, "beat_idx": 6, "kind": "body"}, {"start": 25.568346950088277, "end": 26.813192895661842, "caption": "타이핑할 때마다", "caption_visible": true, "beat_idx": 6, "kind": "body"}, {"start": 26.813192895661842, "end": 27.72, "caption": "덜덜 떨려서", "caption_visible": true, "beat_idx": 6, "kind": "body"}, {"start": 27.72, "end": 28.893352442646613, "caption": "화면 흔들리고", "caption_visible": true, "beat_idx": 7, "kind": "body"}, {"start": 28.893352442646613, "end": 30.72, "caption": "목 노이로제 걸리던 순간도", "caption_visible": true, "beat_idx": 7, "kind": "body"}, {"start": 30.72, "end": 32.04354204259432, "caption": "무거운 노트북까지", "caption_visible": true, "beat_idx": 8, "kind": "body"}, {"start": 32.04354204259432, "end": 33.112298376291925, "caption": "흔들림 없이", "caption_visible": true, "beat_idx": 8, "kind": "body"}, {"start": 33.112298376291925, "end": 34.128, "caption": "딱 잡아준다는 거", "caption_visible": true, "beat_idx": 8, "kind": "body"}, {"start": 34.128, "end": 36.55336609247847, "caption": "근데 진짜 충격적인 포인트는", "caption_visible": true, "beat_idx": 9, "kind": "body"}, {"start": 36.55336609247847, "end": 37.572826205493016, "caption": "펼치자마자", "caption_visible": true, "beat_idx": 9, "kind": "body"}, {"start": 37.572826205493016, "end": 39.21815727628662, "caption": "십자 삼각대로 변신해서", "caption_visible": true, "beat_idx": 9, "kind": "body"}, {"start": 39.21815727628662, "end": 40.42801150477461, "caption": "어떤 바닥이든", "caption_visible": true, "beat_idx": 9, "kind": "body"}, {"start": 40.42801150477461, "end": 42.048, "caption": "절대 안 넘어진다는 거임", "caption_visible": true, "beat_idx": 9, "kind": "body"}, {"start": 42.048, "end": 43.824000000000005, "caption": "벌써 품절 난리라는데", "caption_visible": true, "beat_idx": 10, "kind": "body"}]}, "snap": null}
